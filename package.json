{
  "name": "mathcats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Math Cats — a mobile-first, local-first multiplication & division practice game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
